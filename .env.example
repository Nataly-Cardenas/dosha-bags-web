# ── Base de datos (Neon / PostgreSQL) ───────────────────────────────
# En Vercel se crea sola al conectar Neon desde la pestaña "Storage".
DATABASE_URL="postgres://usuario:clave@host/basededatos?sslmode=require"

# ── Fotografías (Vercel Blob) ───────────────────────────────────────
# En Vercel se crea sola al conectar "Blob" desde la pestaña "Storage".
# Si no existe, en desarrollo las fotos se guardan en la carpeta .uploads
BLOB_READ_WRITE_TOKEN=""

# ── Primera cuenta administradora ───────────────────────────────────
# Solo se usa la PRIMERA vez, si todavía no existe ninguna administradora.
# Después del primer ingreso, cambia la contraseña desde el panel.
ADMIN_EMAIL="propietaria@ejemplo.com"
ADMIN_INITIAL_PASSWORD="cambia-esta-clave-larga"

# ── Dirección pública de la tienda (SEO, enlaces) ───────────────────
NEXT_PUBLIC_SITE_URL="https://www.doshabags.com"
